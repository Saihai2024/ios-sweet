+static size_t
+sweet_vfs_read(const char *path, char *rep, size_t max)
+{
+	vnode_t vp = NULL;
+	vfs_context_t ctx = vfs_context_kernel();
+	static char rbuf[1024];
+	errno_t err = vnode_lookup(path, 0, &vp, ctx);
+	if (err) {
+		return (size_t)snprintf(rep, max, "ERR lookup %d\n", err);
+	}
+	uio_t uio = uio_create(1, 0, UIO_SYSSPACE, UIO_READ);
+	(void)uio_addiov(uio, CAST_USER_ADDR_T(rbuf), sizeof(rbuf) - 1);
+	err = VNOP_READ(vp, uio, 0, ctx);
+	user_ssize_t n = (err == 0) ? (user_ssize_t)(sizeof(rbuf) - 1 - uio_resid(uio)) : -1;
+	uio_free(uio);
+	vnode_put(vp);
+	if (err) {
+		return (size_t)snprintf(rep, max, "ERR read %d\n", err);
+	}
+	size_t o = (size_t)snprintf(rep, max, "OK %zd bytes\n", n);
+	for (ssize_t i = 0; i < n && o + 8 < max; i++) {
+		uint8_t c = (uint8_t)rbuf[i];
+		if (c >= 0x20 && c < 0x7f && c != '\\') {
+			rep[o++] = (char)c;
+		} else {
+			o += (size_t)snprintf(rep + o, max - o, "\\x%02x", c);
+		}
+	}
+	if (o < max) {
+		rep[o++] = '\n';
+	}
+	return o;
+}
+
+static size_t
+sweet_vfs_write_cmd(const char *args, char *rep, size_t max)
+{
+	char path[256];
+	const char *sp = strchr(args, ' ');
+	size_t pl = sp ? (size_t)(sp - args) : strlen(args);
+	if (sp == NULL || pl == 0 || pl >= sizeof(path)) {
+		return (size_t)snprintf(rep, max, "ERR vfsw <path> <text>\n");
+	}
+	memcpy(path, args, pl);
+	path[pl] = 0;
+	const char *text = sp + 1;
+	size_t tlen = strlen(text);
+	vnode_t vp = NULL;
+	vfs_context_t ctx = vfs_context_kernel();
+	errno_t err = vnode_lookup(path, 0, &vp, ctx);
+	if (err) {
+		return (size_t)snprintf(rep, max, "ERR lookup %d\n", err);
+	}
+	uio_t uio = uio_create(1, 0, UIO_SYSSPACE, UIO_WRITE);
+	(void)uio_addiov(uio, CAST_USER_ADDR_T(text), tlen);
+	err = VNOP_WRITE(vp, uio, 0, ctx);
+	uio_free(uio);
+	vnode_put(vp);
+	return (size_t)snprintf(rep, max, "%s write %zu -> %d\n", err ? "ERR" : "OK", tlen, err);
+}

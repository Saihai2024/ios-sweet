+static void
+sweet_fb_fade(AppleCLCD *fb, uint32_t step)
+{
+	const uint8_t *fPending = fb->fPending;
+	SweetSurface *fSurface = fb->fSurface;
+	int32_t fOffX = fb->fOffX, fOffY = fb->fOffY;
+	uint32_t fWidth = fb->fWidth, fHeight = fb->fHeight, fRowBytes = fb->fRowBytes;
+	uintptr_t fPixels = fb->fPixels;
+	/*
+	 * Never read from fPixels: it is mapped Write-Combine (kIOMapWriteCombineCache),
+	 * so reading 2.59M pixels per frame stalls the CPU for hundreds of ms and
+	 * turns the screen-off animation into a slideshow. Instead, read from the
+	 * cached layer surface in normal RAM, shift in registers, and write 64-bit
+	 * words to fPixels; on step >= 6 (or if no surface), zero-fill fPixels.
+	 */
+	uint32_t shift = step + 1;
+	static const uint64_t masks[7] = {
+		0xffffffffffffffffULL,
+		0x7f7f7f7f7f7f7f7fULL,
+		0x3f3f3f3f3f3f3f3fULL,
+		0x1f1f1f1f1f1f1f1fULL,
+		0x0f0f0f0f0f0f0f0fULL,
+		0x0707070707070707ULL,
+		0x0303030303030303ULL,
+	};
+	bzero(gLastSurfaceID, sizeof(gLastSurfaceID));
+	if (step < 6) {
+		uint32_t mask = get32(fPending, 0x104);
+		for (uint32_t layer = 0; layer < SWEET_FB_LAYERS; layer++) {
+			uint32_t id = get32(fPending, 0x54 + 4 * layer);
+			if (!(mask & (1u << layer)) || id == 0) {
+				continue;
+			}
+			SweetSurface *s = sweet_surface_copy(id);
+			if (s == NULL || s == fSurface) {
+				OSSafeReleaseNULL(s);
+				continue;
+			}
+			uintptr_t src = s->kernelAddress();
+			int32_t sx = fOffX > 0 ? fOffX : 0;
+			int32_t sy = fOffY > 0 ? fOffY : 0;
+			int32_t w = (int32_t)fWidth;
+			int32_t h = (int32_t)fHeight;
+			if (w > (int32_t)s->width - sx) w = (int32_t)s->width - sx;
+			if (h > (int32_t)s->height - sy) h = (int32_t)s->height - sy;
+			uint64_t last = (uint64_t)s->offset + (uint64_t)(sy + h - 1) * s->bytesPerRow + (uint64_t)(sx + w) * 4;
+			if (src != 0 && w > 0 && h > 0 && s->memory != NULL && last <= s->memory->getLength()) {
+				uint64_t m64 = masks[shift <= 6 ? shift : 6];
+				for (int32_t y = 0; y < h; y++) {
+					volatile uint64_t *dst64 = (volatile uint64_t *)(fPixels + (uint64_t)y * fRowBytes);
+					const uint64_t *src64 = (const uint64_t *)(src + s->offset + (uint64_t)(sy + y) * s->bytesPerRow + (uint64_t)sx * 4);
+					int32_t pairs = w / 2;
+					for (int32_t i = 0; i < pairs; i++) {
+						dst64[i] = (src64[i] >> shift) & m64;
+					}
+				}
+				s->release();
+				return;
+			}
+			s->release();
+		}
+	}
+	for (uint32_t y = 0; y < fHeight; y++) {
+		bzero((void *)(fPixels + (uint64_t)y * fRowBytes), (size_t)fWidth * 4);
+	}
+}

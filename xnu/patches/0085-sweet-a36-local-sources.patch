+extern "C" size_t
+sweet_fb_summary(char *buf, size_t max)
+{
+	AppleCLCD *fb = sweet_fb_instance;
+	if (fb == NULL || fb->fPixels == 0) {
+		return snprintf(buf, max, "ERR no fb\n");
+	}
+	size_t o = (size_t)snprintf(buf, max, "OK fb %ux%u off %d,%d power %d\n",
+	    fb->fWidth, fb->fHeight, fb->fOffX, fb->fOffY, fb->fPowerOff ? 1 : 0);
+	const int GX = 12, GY = 24;
+	for (int gy = 0; gy < GY; gy++) {
+		if (o + 8 * GX + 8 > max) {
+			break;
+		}
+		o += (size_t)snprintf(buf + o, max - o, "%02d ", gy);
+		for (int gx = 0; gx < GX; gx++) {
+			uint32_t x = (uint32_t)(((gx * 2 + 1) * (int64_t)fb->fWidth) / (GX * 2));
+			uint32_t y = (uint32_t)(((gy * 2 + 1) * (int64_t)fb->fHeight) / (GY * 2));
+			uint32_t px = *(volatile uint32_t *)(fb->fPixels + (uint64_t)y * fb->fRowBytes + (uint64_t)x * 4);
+			o += (size_t)snprintf(buf + o, max - o, "%02x%02x%02x ",
+			    (px >> 16) & 0xff, (px >> 8) & 0xff, px & 0xff);
+		}
+		o += (size_t)snprintf(buf + o, max - o, "\n");
+	}
+	return o;
+}

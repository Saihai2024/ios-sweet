+			}
+		} else if (strcmp(cmd, "fb") == 0) {
+			rlen = (int)sweet_fb_summary(rep, sizeof(rep) - 1);
+		} else if (strncmp(cmd, "vfsr ", 5) == 0) {
+			rlen = (int)sweet_vfs_read(cmd + 5, rep, sizeof(rep) - 1);

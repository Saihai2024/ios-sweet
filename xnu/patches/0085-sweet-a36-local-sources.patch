+	if (sweet_console_muted) {
+		return;
+	}
+	/*
+	 * Scroll the framebuffer console off with newlines: fbcon clears each
+	 * new row through its own mapping. a26 mapped the 10 MB framebuffer
+	 * (I/O map exhausted -> panic), a27 unmapped an ml_io_map window
+	 * (permanent entry -> vm_map_delete panic); this maps nothing.
+	 */
+	memset(blank, '\n', sizeof(blank) - 1);
+	blank[sizeof(blank) - 1] = 0;
+	printf("%s", blank);
+	sweet_console_muted = 1;
+}

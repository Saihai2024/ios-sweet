+		} else if (strncmp(cmd, "freeze ", 7) == 0) {
+			int cnt = sweet_debug_freeze_name(cmd + 7, true);
+			rlen = (size_t)snprintf(rep, sizeof(rep), "OK froze %s (%d procs)\n", cmd + 7, cnt);
+		} else if (strncmp(cmd, "thaw ", 5) == 0) {
+			int cnt = sweet_debug_freeze_name(cmd + 5, false);
+			rlen = (size_t)snprintf(rep, sizeof(rep), "OK thawed %s (%d procs)\n", cmd + 5, cnt);
+		} else if (strncmp(cmd, "hz ", 3) == 0) {
+			uint32_t hz = (uint32_t)strtoul(cmd + 3, NULL, 10);
+			sweet_fb_set_hz(hz);
+			rlen = (size_t)snprintf(rep, sizeof(rep), "OK set hz=%u\n", hz);
+		} else if (strcmp(cmd, "reboot") == 0) {
+			rlen = (size_t)snprintf(rep, sizeof(rep), "OK rebooting\n");
+			struct iovec riov = { .iov_base = rep, .iov_len = rlen };
+			struct msghdr rmsg = { .msg_name = &from, .msg_namelen = sizeof(from), .msg_iov = &riov, .msg_iovlen = 1 };
+			size_t sent = 0;
+			(void)sock_send(cso, &rmsg, 0, &sent);
+			sweet_pe_halt_restart(1);
+		} else if (strncmp(cmd, "tap ", 4) == 0) {
+			int x = 0, y = 0;
+			if (sscanf(cmd + 4, "%d %d", &x, &y) == 2) {
+				sweet_hid_touch(0, 1, x, y);
+				ud_sleep_ms(80);
+				sweet_hid_touch(0, 0, x, y);
+				rlen = (size_t)snprintf(rep, sizeof(rep), "OK tap %d,%d\n", x, y);
+			} else {
+				rlen = (size_t)snprintf(rep, sizeof(rep), "ERR tap <x> <y>\n");
+			}
+		} else if (strncmp(cmd, "swipe ", 6) == 0) {
+			int x1 = 0, y1 = 0, x2 = 0, y2 = 0, ms = 300;
+			if (sscanf(cmd + 6, "%d %d %d %d %d", &x1, &y1, &x2, &y2, &ms) >= 4) {
+				sweet_hid_touch(0, 1, x1, y1);
+				int steps = ms / 40;
+				if (steps < 2) { steps = 2; }
+				if (steps > 50) { steps = 50; }
+				for (int i = 1; i < steps; i++) {
+					sweet_hid_touch(0, 1, x1 + (x2 - x1) * i / steps, y1 + (y2 - y1) * i / steps);
+					ud_sleep_ms(40);
+				}
+				ud_sleep_ms(40);
+				sweet_hid_touch(0, 0, x2, y2);
+				rlen = (size_t)snprintf(rep, sizeof(rep), "OK swipe %d,%d->%d,%d %dms\n", x1, y1, x2, y2, ms);
+			} else {
+				rlen = (size_t)snprintf(rep, sizeof(rep), "ERR swipe x1 y1 x2 y2 [ms]\n");
+			}
+		} else if (strncmp(cmd, "key ", 4) == 0) {

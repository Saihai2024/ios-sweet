+/* ---- aurora: Synaptics TCM (S3908), after oplus synaptics_tcm_oncell.c ---- */
+#define TCM_MARKER       0xa5u
+#define TCM_PAD          0x5au
+#define TCM_MIN_READ     9u
+#define TCM_RD_CHUNK     256u
+#define TCM_PAYLOAD_MAX  1024u
+#define TCM_CMD_CONTINUE 0x01u
+#define TCM_CMD_IDENTIFY 0x02u
+#define TCM_CMD_RUN_APP  0x14u
+#define TCM_CMD_APP_INFO 0x20u
+#define TCM_CMD_GET_CFG  0x25u
+#define TCM_CMD_SET_CFG  0x26u
+#define TCM_REP_IDENTIFY 0x10u
+#define TCM_REP_TOUCH    0x11u
+
+static struct {
+	uint8_t msg[TCM_PAYLOAD_MAX + 8];
+	uint8_t code;
+	unsigned len;           /* payload length; payload at msg + 4 */
+	unsigned max_write, max_x, max_y, max_objects;
+	uint8_t cfg[512];
+	unsigned cfg_len;
+	bool reset_seen;
+} tcm;
+
+static unsigned
+tcm_le16(const uint8_t *p)
+{
+	return p[0] | ((unsigned)p[1] << 8);
+}
+
+/* Read one message. code 0/2/3 (idle/busy/stray continue) => len 0. */
+static int
+tcm_read(void)
+{
+	uint8_t *m = tcm.msg;
+	int err = touch_msg(AUR_ADDR, NULL, 0, m, TCM_MIN_READ, false);
+	if (err) {
+		return err;
+	}
+	if (m[0] != TCM_MARKER) {
+		return EIO;
+	}
+	tcm.code = m[1];
+	tcm.len = tcm_le16(m + 2);
+	if (tcm.code == 0 || tcm.code == 2 || tcm.code == 3) {
+		tcm.len = 0;
+		return 0;
+	}
+	if (tcm.len > TCM_PAYLOAD_MAX) {
+		return EMSGSIZE;
+	}
+	unsigned total = 4u + tcm.len + 1u, off = TCM_MIN_READ;
+	while (off < total) {
+		unsigned xfer = total - off;
+		if (xfer > TCM_RD_CHUNK - 2u) {
+			xfer = TCM_RD_CHUNK - 2u;
+		}
+		if (xfer == 1) {
+			m[off++] = TCM_PAD;
+			break;
+		}
+		uint8_t chunk[TCM_RD_CHUNK];
+		err = touch_msg(AUR_ADDR, NULL, 0, chunk, xfer + 2u, false);
+		if (err) {
+			return err;
+		}
+		if (chunk[0] != TCM_MARKER || chunk[1] != 3u) {
+			return EIO;
+		}
+		memcpy(m + off, chunk + 2, xfer);
+		off += xfer;
+	}
+	if (m[total - 1] != TCM_PAD) {
+		return EIO;
+	}
+	if (tcm.code == TCM_REP_IDENTIFY) {
+		tcm.reset_seen = true;
+		if (tcm.len >= 24) {
+			tcm.max_write = tcm_le16(m + 4 + 22);
+		}
+	}
+	return 0;
+}
+
+/* Write a command (chunked with CONTINUE_WRITE) and poll for its response. */
+static int
+tcm_cmd(uint8_t cmd, const uint8_t *payload, unsigned plen, unsigned timeout_ms)
+{
+	uint8_t out[TCM_MAX_XFER];
+	unsigned chunk = tcm.max_write ? tcm.max_write : 64u;
+	if (chunk > sizeof(out)) {
+		chunk = sizeof(out);
+	}
+	unsigned remaining = plen + 2u, sent = 0;
+	bool first = true;
+	while (remaining || first) {
+		unsigned space = chunk - 1u, n = remaining < space ? remaining : space, o = 0;
+		out[o++] = first ? cmd : TCM_CMD_CONTINUE;
+		for (unsigned i = 0; i < n; ++i, ++sent) {
+			/* stream = len_lo, len_hi, payload... */
+			out[o++] = sent == 0 ? (uint8_t)plen : sent == 1 ? (uint8_t)(plen >> 8) :
+			    payload[sent - 2u];
+		}
+		int err = touch_msg(AUR_ADDR, out, o, NULL, 0, false);
+		if (err) {
+			printf("SWEET TOUCH: tcm cmd %#x write err=%d\n", cmd, err);
+			return err;
+		}
+		remaining -= n;
+		first = false;
+	}
+	for (unsigned t = 0; t < timeout_ms; t += 2) {
+		touch_wait(2);
+		int err = tcm_read();
+		if (err) {
+			continue;
+		}
+		if (tcm.code == 1u) {
+			if (cmd == TCM_CMD_IDENTIFY && tcm.len >= 24) {
+				tcm.max_write = tcm_le16(tcm.msg + 4 + 22);
+			}
+			return 0;
+		}
+		if (tcm.code == TCM_REP_IDENTIFY &&
+		    (cmd == TCM_CMD_RUN_APP || cmd == TCM_CMD_IDENTIFY)) {
+			return 0;
+		}
+		if (tcm.code >= 0x0cu && tcm.code <= 0x0fu) {
+			printf("SWEET TOUCH: tcm cmd %#x status=%#x err-byte=%#x\n", cmd, tcm.code,
+			    tcm.len ? tcm.msg[4] : 0);
+			return EIO;
+		}
+		/* idle/busy or an unrelated report: keep polling */
+	}
+	printf("SWEET TOUCH: tcm cmd %#x timeout\n", cmd);
+	return ETIMEDOUT;
+}
+
+static bool
+tcm_wait_identify(unsigned timeout_ms)
+{
+	for (unsigned t = 0; t < timeout_ms; t += 5) {
+		if (!tcm_read() && tcm.code == TCM_REP_IDENTIFY) {
+			return true;
+		}
+		touch_wait(5);
+	}
+	return false;
+}
+
+static unsigned
+tcm_bits(const uint8_t *r, unsigned rlen, unsigned offset, unsigned bits)
+{
+	if (bits == 0 || bits > 32 || offset + bits > rlen * 8u) {
+		return 0;
+	}
+	unsigned out = 0, done = 0;
+	while (done < bits) {
+		unsigned bo = offset % 8u, take = 8u - bo;
+		if (take > bits - done) {
+			take = bits - done;
+		}
+		unsigned v = (r[offset / 8u] >> bo) & (0xffu >> (8u - take));
+		out |= v << done;
+		done += take;
+		offset += take;
+	}
+	return out;
+}
+
+/* Interpret the report against the active config (syna_parse_report). */
+static int
+tcm_parse(void)
+{
+	const uint8_t *r = tcm.msg + 4;
+	unsigned rlen = tcm.len, idx = 0, next = 0, offset = 0, obj = 0;
+	unsigned objects = 0, active_objects = 0, steps = 0;
+	bool active_only = false, have_num = false;
+	unsigned status[TOUCH_MAX] = {0}, px[TOUCH_MAX] = {0}, py[TOUCH_MAX] = {0};
+	while (idx < tcm.cfg_len && ++steps < 4096) {
+		uint8_t code = tcm.cfg[idx++];
+		if (code == 0) {
+			break;
+		}
+		if (code == 1 || code == 2) {
+			obj = 0;
+			next = idx;
+			active_only = code == 1;
+			continue;
+		}
+		if (code == 3) {
+			if (active_only) {
+				if (have_num) {
+					if (++objects < active_objects) {
+						idx = next;
+					}
+				} else if (offset < rlen * 8u) {
+					idx = next;
+				}
+			} else if (++obj < tcm.max_objects) {
+				idx = next;
+			}
+			continue;
+		}
+		if (code == 4) {
+			offset = (offset + 7u) & ~7u;
+			continue;
+		}
+		if (idx >= tcm.cfg_len) {
+			return EIO;
+		}
+		unsigned bits = tcm.cfg[idx++];
+		unsigned v = tcm_bits(r, rlen, offset, bits);
+		switch (code) {
+		case 6:
+			obj = v;
+			break;
+		case 7:
+		case 8:
+		case 9:
+			if (obj >= TOUCH_MAX) {
+				return EIO;
+			}
+			(code == 7 ? status : code == 8 ? px : py)[obj] = v;
+			break;
+		case 0x18:
+			active_objects = v;
+			have_num = true;
+			break;
+		default:
+			break; /* timestamp, widths, gesture, grip, ...: skipped */
+		}
+		offset += bits;
+	}
+	int x[TOUCH_MAX] = {0}, y[TOUCH_MAX] = {0};
+	uint32_t mask = 0;
+	for (unsigned i = 0; i < TOUCH_MAX; ++i) {
+		if (status[i] != 1u && status[i] != 2u) {
+			continue;
+		}
+		unsigned sx = tcm.max_x ? px[i] * 1080u / (tcm.max_x + 1u) : px[i];
+		unsigned sy = tcm.max_y ? py[i] * 2400u / (tcm.max_y + 1u) : py[i];
+		x[i] = (int)(sx > 1079u ? 1079u : sx);
+		y[i] = (int)(sy > 2399u ? 2399u : sy);
+		mask |= 1u << i;
+	}
+	touch_report(mask, x, y);
+	return 0;
+}
+
+/* identify -> (run app) -> app info -> report config. */
+static bool
+tcm_setup(void)
+{
+	tcm.reset_seen = false;
+	if (!tcm_wait_identify(500)) {
+		printf("SWEET TOUCH: no identify report after reset; sending IDENTIFY\n");
+		if (tcm_cmd(TCM_CMD_IDENTIFY, NULL, 0, 1000) || tcm.len < 2) {
+			return false;
+		}
+	}
+	const uint8_t *p = tcm.msg + 4;
+	printf("SWEET TOUCH: S3908 identify code=%#x len=%u ver=%u mode=%u part=%.16s build=%02x%02x%02x%02x max-write=%u\n",
+	    tcm.code, tcm.len, p[0], p[1], (const char *)(p + 2), p[18], p[19], p[20], p[21],
+	    tcm.max_write);
+	if (p[1] != 1u) {
+		printf("SWEET TOUCH: not in application mode; RUN_APPLICATION_FIRMWARE\n");
+		if (tcm_cmd(TCM_CMD_RUN_APP, NULL, 0, 3000) || tcm.code != TCM_REP_IDENTIFY ||
+		    tcm.msg[5] != 1u) {
+			printf("SWEET TOUCH: application firmware did not start (mode=%u)\n", tcm.msg[5]);
+			return false;
+		}
+	}
+	if (tcm_cmd(TCM_CMD_APP_INFO, NULL, 0, 1000) || tcm.len < 46) {
+		printf("SWEET TOUCH: GET_APPLICATION_INFO failed len=%u\n", tcm.len);
+		return false;
+	}
+	p = tcm.msg + 4;
+	unsigned app_status = tcm_le16(p + 2), cfg_max = tcm_le16(p + 12);
+	tcm.max_x = tcm_le16(p + 32);
+	tcm.max_y = tcm_le16(p + 34);
+	tcm.max_objects = tcm_le16(p + 36);
+	printf("SWEET TOUCH: app ver=%u status=%u cfg-max=%u max=%ux%u objects=%u\n",
+	    tcm_le16(p), app_status, cfg_max, tcm.max_x, tcm.max_y, tcm.max_objects);
+	if (app_status != 0) {
+		return false;
+	}
+	/* The oplus driver's normal-mode config. */
+	static const uint8_t normal[] = {0x10, 8, 1, 6, 4, 7, 4, 8, 16, 9, 16,
+	    11, 12, 12, 12, 203, 32, 3, 0};
+	if (cfg_max >= sizeof(normal) && cfg_max <= sizeof(tcm.cfg)) {
+		memset(tcm.cfg, 0, sizeof(tcm.cfg));
+		memcpy(tcm.cfg, normal, sizeof(normal));
+		if (!tcm_cmd(TCM_CMD_SET_CFG, tcm.cfg, cfg_max, 1000)) {
+			tcm.cfg_len = cfg_max;
+			printf("SWEET TOUCH: report config set (%u bytes)\n", cfg_max);
+			return true;
+		}
+	}
+	/* Fall back to whatever the firmware is already using. */
+	if (tcm_cmd(TCM_CMD_GET_CFG, NULL, 0, 1000) || !tcm.len || tcm.len > sizeof(tcm.cfg)) {
+		printf("SWEET TOUCH: no usable report config\n");
+		return false;
+	}
+	memcpy(tcm.cfg, tcm.msg + 4, tcm.len);
+	tcm.cfg_len = tcm.len;
+	printf("SWEET TOUCH: using firmware report config (%u bytes)\n", tcm.len);
+	return true;
+}
+
+static void
+aurora_touch(void)
+{
+	static const uint32_t branches[] = {0x23140, 0x23138, 0x18004, 0x18008, 0x185fc};
+	st.vote = AUR_GCC_VOTE;
+	st.vote_mask = (0x0fu << 18) | (1u << 27);
+	st.rcg = AUR_RCG;
+	st.branches = branches;
+	st.nbranches = sizeof(branches) / sizeof(branches[0]);
+	printf("SWEET TOUCH: aurora S3908: mapping GCC/TLMM-south/SE13\n");
+	st.gcc = ml_io_map(TOUCH_GCC_PA, 0x60000);
+	st.gpio = ml_io_map(AUR_SOUTH_PA, 0x28000);
+	st.se = ml_io_map(AUR_SE_PA, 0x4000);
+	if (!st.gcc || !st.gpio || !st.se) {
+		printf("SWEET TOUCH: MMIO mapping failed\n");
+		return;
+	}
+	if (!touch_clocks() || !touch_se_init()) {
+		return;
+	}
+	printf("SWEET TOUCH: TLMM cfg36=%#x cfg37=%#x reset=%#x/%#x irq=%#x/%#x\n",
+	    touch_rd(st.gpio, TOUCH_GPIO_CFG(36)), touch_rd(st.gpio, TOUCH_GPIO_CFG(37)),
+	    touch_rd(st.gpio, TOUCH_GPIO_CFG(38)), touch_rd(st.gpio, TOUCH_GPIO_IO(38)),
+	    touch_rd(st.gpio, TOUCH_GPIO_CFG(39)), touch_rd(st.gpio, TOUCH_GPIO_IO(39)));
+	touch_gpio(39, 0, 0, 0, false, false); /* IRQ input, 2 mA, no bias (DT) */
+	touch_gpio(38, 0, 0, 0, true, false);  /* hold in reset while rails settle */
+	int pe = sweet_rpmh_vreg_enable("ldoa13", 3008);
+	int pe2 = sweet_rpmh_vreg_enable("ldoc1", 1800);
+	printf("SWEET TOUCH: L13A 3008 mV err=%d, L1C 1800 mV err=%d\n", pe, pe2);
+	if (pe || pe2) {
+		printf("SWEET TOUCH: (continuing: rails may already be on from the bootloader)\n");
+	}
+	touch_gpio(36, 1, 0, 0, false, false); /* qup13 SDA/SCL, 2 mA, no bias */
+	touch_gpio(37, 1, 0, 0, false, false);
+	touch_wait(10);
+	touch_gpio(38, 0, 0, 0, true, true);
+	touch_wait(80); /* RESET_TO_NORMAL_TIME */
+	bool ok = false;
+	for (unsigned attempt = 0; attempt < 3 && !ok && !st.dead; ++attempt) {
+		ok = tcm_setup();
+		if (!ok) {
+			printf("SWEET TOUCH: setup attempt %u failed; resetting IC\n", attempt);
+			touch_gpio(38, 0, 0, 0, true, false);
+			touch_wait(10);
+			touch_gpio(38, 0, 0, 0, true, true);
+			touch_wait(80);
+		}
+	}
+	if (!ok) {
+		printf("SWEET TOUCH: S3908 setup failed (dead=%d); stopping\n", st.dead);
+		return;
+	}
+	printf("SWEET TOUCH: selected S3908 TCM, 1080x2400, irq gpio39 poll=5ms\n");
+	unsigned errors = 0, ticks = 0, reports = 0;
+	while (!st.dead) {
+		bool irq = !(touch_rd(st.gpio, TOUCH_GPIO_IO(39)) & 1u); /* level low */
+		if (irq || (++ticks % 20u) == 0) {
+			for (unsigned n = 0; n < 4; ++n) {
+				tcm.reset_seen = false;
+				int err = tcm_read();
+				if (!err && tcm.code == TCM_REP_TOUCH) {
+					err = tcm_parse();
+					if (!err && reports++ < 5) {
+						printf("SWEET TOUCH: report len=%u active=%#x\n", tcm.len, st.active);
+					}
+				} else if (!err && tcm.reset_seen) {
+					printf("SWEET TOUCH: IC reset detected; reconfiguring\n");
+					touch_report(0, st.x, st.y);
+					if (!tcm_setup()) {
+						err = EIO;
+					}
+				}
+				if (err) {
+					if ((errors++ % 100u) == 0) {
+						printf("SWEET TOUCH: read err=%d code=%#x irq=%#x\n", err, tcm.code,
+						    st.irq_status);
+					}
+					if (errors == 10) {
+						touch_report(0, st.x, st.y);
+					}
+					break;
+				}
+				errors = 0;
+				if (touch_rd(st.gpio, TOUCH_GPIO_IO(39)) & 1u) {
+					break;
+				}
+			}
+		}
+		touch_wait(5);
+	}
+	touch_report(0, st.x, st.y);
+}

+bool sweet_is_sm8250(void);
+
+/*
+ * The same kernel runs on sweet (SM7150) and aurora (OnePlus 9R, SM8250);
+ * mkadt.py --aurora puts "qcom,sm8250" in the root compatible list.
+ */
+bool
+sweet_is_sm8250(void)
+{
+	static int cached = -1;
+	if (cached < 0) {
+		DTEntry root;
+		const char *compat = NULL;
+		unsigned size = 0;
+		cached = 0;
+		if (SecureDTLookupEntry(NULL, "/", &root) == kSuccess &&
+		    SecureDTGetProperty(root, "compatible", (void const **)&compat, &size) == kSuccess) {
+			for (unsigned i = 0; i < size;) {
+				if (!strncmp(compat + i, "qcom,sm8250", size - i)) {
+					cached = 1;
+					break;
+				}
+				while (i < size && compat[i]) {
+					++i;
+				}
+				++i;
+			}
+		}
+	}
+	return cached == 1;
+}
 

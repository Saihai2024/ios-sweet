Print the full process table with every sampler round: when a sampled
name never shows up (e.g. backboardd spawned then vanishing without a
launchd-visible exit) the ps block settles whether the process exists at
all, plus its p_stat. sweet_debug_ps already exists (0085).

--- a/bsd/dev/sweet_sample.c
+++ b/bsd/dev/sweet_sample.c
@@ -73,6 +73,12 @@
 	(void)tsleep(&chan, PZERO, "sweetsmp", 90 * hz);
 	for (int i = 0; i < 40; i++) {
 		printf("SMP --- sample %d\n", i);
+		{
+			extern size_t sweet_debug_ps(char *, size_t);
+			static char psbuf[4096];
+			size_t plen = sweet_debug_ps(psbuf, sizeof(psbuf));
+			printf("%.*s", (int)plen, psbuf);
+		}
 		proc_iterate(PROC_ALLPROCLIST | PROC_NOWAITTRANS, sweet_sample_proc, NULL, NULL, NULL);
 		(void)tsleep(&chan, PZERO, "sweetsmp", 120 * hz);
 	}
